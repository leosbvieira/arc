# copie para .env e edite. NUNCA comite o .env.
APP_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa
JWT_TTL_HOURS=720

# Hermes: em mock (default) o BFF responde sem rede. Quando o Hermes estiver de pé,
# ponha HERMES_MOCK=false, a URL e a chave.
HERMES_MOCK=true
HERMES_BASE_URL=http://localhost:8080
HERMES_API_KEY=
HERMES_PROFILE_CAPTURE=Capturas

# Expo Push Service (não precisa de credencial no BFF; a Expo/EAS gerencia o FCM).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Telegram: canal do digest no P1 (spec §6). Vazios = canal desligado (send() vira no-op).
# Gate manual (Q3): copiar o token do bot do Hermes e o chat_id do Leo pra ligar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Digest v2 (C10/C11) — knobs opcionais (têm default no código):
#   STAGING_AGE_DAYS: idade (dias) a partir da qual a linha de staging aparece.
#   ROUTINE_MISS_THRESHOLD: nº de furos em 7 dias pra rotina virar padrão.
#   SENSITIVE_AREAS: CSV de áreas neutralizadas no Telegram (lockscreen mostra tudo, lei 7).
# STAGING_AGE_DAYS=3
# ROUTINE_MISS_THRESHOLD=3
# SENSITIVE_AREAS=Corpo,Saúde Mental

# token que o cron do Hermes usa pra chamar /internal/notify (server-to-server).
INTERNAL_TOKEN=troque-token-interno

# Vault: PAT fine-grained (Contents:write) do repo do vault; o BFF escreve verbatim.
GITHUB_PAT=
# owner/repo do vault no GitHub.
VAULT_REPO=leosbvieira/aeternum
# branch alvo das escritas no vault.
VAULT_BRANCH=main

DB_PATH=data.db
