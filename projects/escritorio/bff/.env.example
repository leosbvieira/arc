# copie para .env e edite. NUNCA comite o .env.
APP_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-32-ou-mais-caracteres-aleatorios
JWT_TTL_HOURS=720

# Hermes: em mock (default) o BFF responde sem rede. Quando o Hermes estiver de pé,
# ponha HERMES_MOCK=false, a URL e a chave.
HERMES_MOCK=true
HERMES_BASE_URL=http://localhost:8080
HERMES_API_KEY=
HERMES_PROFILE_CAPTURE=Capturas

# Calendários: feeds privados abaixo são somente leitura. Para inserir explicitamente
# no Google Calendar pessoal, configure um OAuth client + refresh token com escopo
# Calendar Events. Outlook nunca recebe escrita.
GCAL_ICS_URL=
OUTLOOK_ICS_URL=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEOUT=20

# Expo Push Service (não precisa de credencial no BFF; a Expo/EAS gerencia o FCM).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Telegram: canal do digest no P1 (spec §6). Vazios = canal desligado (send() vira no-op).
# Gate manual (Q3): copiar o token do bot do Hermes e o chat_id do Leo pra ligar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Digest v2 (C10/C11) — knobs opcionais (têm default no código):
#   STAGING_AGE_DAYS: idade (dias) a partir da qual a linha de staging aparece.
#   ROUTINE_MISS_THRESHOLD: nº de furos em 7 dias pra rotina virar padrão.
#   SENSITIVE_AREAS: CSV de áreas neutralizadas no Telegram (lockscreen mostra tudo, lei 7).
# STAGING_AGE_DAYS=3
# ROUTINE_MISS_THRESHOLD=3
# SENSITIVE_AREAS=Corpo,Saúde Mental

# Pontos + Conquistas N1-4 (P2 item 3) — knobs opcionais (têm default no código).
# "fazer ganha, furar desconta POUCO": o desconto só existe em PADRÃO (o limiar é o
# ROUTINE_MISS_THRESHOLD acima, o mesmo do digest), custa 1x por semana por rotina —
# nunca por furo — e ainda passa pelo teto semanal. Mexer aqui muda o placar INTEIRO,
# passado incluso: os pontos são derivados dos checks, não um saldo gravado.
#   PONTOS_POR_ROTINA: ganho por rotina marcada como feita no fechamento.
#   DESCONTO_PADRAO: custo de UMA rotina em padrão, uma vez na semana.
#   TETO_DESCONTO_SEMANAL: o desconto de uma semana nunca passa disso.
#   CICLO_SEMANAS / CICLO_INICIO: o 12WY e sua segunda-feira âncora.
#   NIVEL_LIMIARES: limiares VITALÍCIOS de N1..N4, em JSON. O nível sai do PICO
#     histórico do saldo — ele nunca regride (lei 4: jamais streak-reset).
# PONTOS_POR_ROTINA=1
# DESCONTO_PADRAO=3
# TETO_DESCONTO_SEMANAL=10
# CICLO_SEMANAS=12
# CICLO_INICIO=2026-07-06
# NIVEL_LIMIARES=[700, 1700, 3400, 6800]

# token que o cron do Hermes usa pra chamar /internal/notify (server-to-server).
INTERNAL_TOKEN=troque-token-interno

# Vault: PAT fine-grained (Contents:write) do repo do vault; o BFF escreve verbatim.
GITHUB_PAT=
# owner/repo do vault no GitHub.
VAULT_REPO=leosbvieira/aeternum
# branch alvo das escritas no vault.
VAULT_BRANCH=main

DB_PATH=data.db
# Segundo destino do backup diário, em OUTRO volume (vazio = desligado). O primeiro
# fica em backups/ ao lado do data.db e não sobrevive à perda do disco.
BACKUP_DIR_2=
# Hermes como CLI oneshot (subprocesso). Nome no PATH ou caminho absoluto do `hermes`.
# HERMES_BIN=hermes
# HERMES_TIMEOUT=150
