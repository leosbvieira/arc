# CANDIDATO — nenhum comando daqui foi executado num VPS. Trocar __RELEASE_ID__
# antes de instalar. Adaptado do ramo local-2026-09 para a arquitetura da nuvem:
# o BFF NÃO fala com um servidor HTTP do Hermes; ele sobe `hermes -z` como
# SUBPROCESSO a cada chamada (bff/app/hermes_client.py). Por isso:
#   - o usuário do serviço precisa do Hermes instalado E do seu ~/.hermes
#     (config.yaml, SOUL.md, .env com as chaves, sessões). HOME aponta pra um
#     diretório de estado fora de /home, e ProtectHome=true continua valendo;
#   - ProtectSystem=strict + ReadWritePaths cobrindo o estado do BFF (data.db,
#     backups/) e o HOME do Hermes, que escreve sessões e cache do npx (ClickUp MCP);
#   - TimeoutStopSec >= HERMES_TIMEOUT (150s no config.py) + folga: matar o uvicorn
#     no meio de uma captura em curso perde a resposta do agente e deixa a fila
#     em `processing`.
#
# Layout esperado:
#   /opt/escritorio/releases/<id>/bff        código + .venv (imutável por release)
#   /opt/escritorio/hermes/.venv/bin/hermes  Hermes CLI (fora da release do BFF)
#   /var/lib/escritorio-bff/                 data.db, backups/, hermes-home/
#   /etc/escritorio/bff.env                  segredos (root:root 0600) — ver bff.env.example
#   backup_dir_2                             OUTRO volume (BACKUP_DIR_2 no env)

[Unit]
Description=Escritorio BFF (FastAPI + Hermes CLI oneshot)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=escritorio-bff
Group=escritorio-bff
WorkingDirectory=/opt/escritorio/releases/__RELEASE_ID__/bff
EnvironmentFile=/etc/escritorio/bff.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# HOME do Hermes: fora de /home, dentro do StateDirectory. `hermes` resolve
# config/.env/sessões a partir daqui.
Environment=HOME=/var/lib/escritorio-bff/hermes-home
Environment=PATH=/opt/escritorio/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin
# HERMES_BIN também pode ir no bff.env; o PATH acima já resolve `hermes`.
ExecStart=/opt/escritorio/releases/__RELEASE_ID__/bff/.venv/bin/python -m uvicorn app.main:app \
  --host 127.0.0.1 --port 8000 --workers 1 \
  --no-access-log --log-level warning \
  --proxy-headers --forwarded-allow-ips 127.0.0.1 \
  --timeout-graceful-shutdown 165
Restart=on-failure
RestartSec=5
# 150s (HERMES_TIMEOUT) + 165s graceful do uvicorn já contam; 180 é o teto do systemd.
TimeoutStopSec=180
KillMode=mixed
UMask=0077
StateDirectory=escritorio-bff
StateDirectoryMode=0700
ReadWritePaths=/var/lib/escritorio-bff
# Segundo destino do backup (outro volume). Deixe comentado se BACKUP_DIR_2 estiver vazio.
#ReadWritePaths=/mnt/backup2/escritorio-bff
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=escritorio-bff

[Install]
WantedBy=multi-user.target
