# CANDIDATO — não é um arquivo de credenciais utilizável nem entrada de shell.
# Destino: /etc/escritorio/bff.env, root:root 0600, diretório 0700.
# Formato EnvironmentFile do systemd (sem `export`, aspas só quando houver espaço).
# Vazio ou igual ao default do código = o BFF RECUSA subir (config.py / main.py:
# "segredos default detectados ou vazios"). Nunca comite valores preenchidos.
#
# Espelha bff/.env.example (a fonte da verdade das chaves). Quando uma chave nova
# entrar lá, entra aqui.

# --- auth single-user -----------------------------------------------------------
APP_PASSWORD=
JWT_SECRET=
JWT_TTL_HOURS=720
INTERNAL_TOKEN=

# --- banco e backups --------------------------------------------------------------
DB_PATH=/var/lib/escritorio-bff/data.db
# Segundo destino do backup diário, em OUTRO volume. Vazio = só o backups/ ao lado
# do data.db (cobre apagar o arquivo, não cobre perder o disco).
BACKUP_DIR_2=

# --- Hermes (CLI oneshot; nada de servidor HTTP) --------------------------------
HERMES_MOCK=false
HERMES_BIN=/opt/escritorio/hermes/.venv/bin/hermes
HERMES_TIMEOUT=150
HERMES_PROFILE_CAPTURE=Capturas
# Legado do desenho antigo (API server). Não usados pelo cliente CLI; deixe vazios.
HERMES_BASE_URL=
HERMES_API_KEY=

# --- ClickUp (tarefas = REST direto, D-x em DECISIONS.md) ----------------------
TASKS_SOURCE=clickup
CLICKUP_TOKEN=
CLICKUP_VERIFY_SSL=true

# --- calendários (feeds privados são segredo, lei 7) -----------------------------
GCAL_ICS_URL=
OUTLOOK_ICS_URL=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- vault (GitHub) ---------------------------------------------------------------
GITHUB_PAT=
VAULT_REPO=leosbvieira/aeternum
VAULT_BRANCH=main

# --- push + Telegram (push primeiro, Telegram de ponte — D-15) ------------------
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- knobs opcionais (default no código) -----------------------------------------
# STAGING_AGE_DAYS=3
# ROUTINE_MISS_THRESHOLD=3
# SENSITIVE_AREAS=Corpo,Saúde Mental
