{
  "expo": {
    "name": "Aeternum",
    "slug": "escritorio-app",
    "owner": "suwkz",
    "version": "0.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.leo.escritorio",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4EFE7"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080A0D"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que o Aeternum use o microfone durante a sessao de leitura.",
          "speechRecognitionPermission": "Permitir que o Aeternum transcreva a sessao de leitura.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "bffUrl": "http://192.168.0.2:8000",
      "eas": {
        "projectId": "dfd33594-012e-466b-a46f-9c6eb1cfae3d"
      }
    }
  }
}
