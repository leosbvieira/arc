{
  "expo": {
    "name": "escritório",
    "slug": "escritorio-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.leo.escritorio"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que o Aeternum use o microfone durante a sessao de leitura.",
          "speechRecognitionPermission": "Permitir que o Aeternum transcreva a sessao de leitura.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "bffUrl": "http://192.168.0.5:8000",
      "eas": {
        "projectId": ""
      }
    }
  }
}
