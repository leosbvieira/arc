# Copy to .env and fill. NEVER commit .env. NEVER paste these in chat.

# Anthropic — console.anthropic.com -> API keys. Set a SPEND LIMIT on the key.
ANTHROPIC_API_KEY=sk-ant-...

# Telegram — @BotFather /newbot. After creating the bot, /start it so cutuca
# can learn your chat_id (printed to logs on first message; put it in config.yaml).
TELEGRAM_BOT_TOKEN=123456:ABC-...

# ClickUp — Settings -> Apps -> API Token (personal token, starts with pk_).
CLICKUP_TOKEN=pk_...
